# Copy to .env (never commit it) or export these in the environment your scheduler uses.
# Only the features you turn on need their keys; the demo needs none.

# Discovery ([discovery] source = "places"): an API key restricted to the Places API (New).
GOOGLE_PLACES_API_KEY=

# Hand-off ([handoff] mode = "live"), seed test and warmup audit: an Instantly API v2 key.
# Scopes: leads:create for the hand-off, accounts:read for the audit, accounts:read and emails:create for
# the seed test.
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# Optional model writer ([writer] mode = "claude", `uv sync --extra llm`).
ANTHROPIC_API_KEY=

# Seed mailboxes for the inbox-placement test, one pair per [[placement.seeds]] block (IMAP app passwords).
SEED1_IMAP_USER=
SEED1_IMAP_PASSWORD=
